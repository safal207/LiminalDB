{
  "name": "@liminaldb/client",
  "version": "1.0.0",
  "description": "Official TypeScript client for the LiminalDB protocol v1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "node ../../protocol/codegen.js",
    "smoke": "tsx examples/smoke.ts",
    "smoke:require-event": "LIMINAL_SMOKE_REQUIRE_EVENT=1 tsx examples/smoke.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.3.3"
  }
}
